{
    "compilerOptions": {
      "baseUrl": "src",
      "paths": {
        "@components/*": [
          "components/*"
        ],
        "@componentsView/*": [
          "components/views/*"
        ],
        "@controllers/*": [
          "controllers/*"
        ],
        "@models/*": [
          "models/*"
        ],        
        "@modules/*": [
          "modules/*"
        ],
        "@services/*": [
          "services/*"
        ],
        "@views/*": [
          "views/*"
        ],
        "@routes/*": [
          "routes/*"
        ],
        "@interceptors/*": [
          "interceptors/*"
        ],
        "@filters/*": [
          "filters/*"
        ],
      }
    }
  }