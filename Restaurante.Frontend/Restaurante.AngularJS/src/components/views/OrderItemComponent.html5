<div class="container">
    <div class="row">
        <div class="col-auto d-flex gap-1">
            <p class="fw-bold">{{ctrl.infoId}}</p>
            <p>x{{ctrl.infoQuantity}}</p>
        </div>
        <div class="col-auto ms-auto">
            <div class="gap-1">
                <button class="btn btn-outline-success" ng-click="ctrl.onPlus(ctrl.infoId)">+</button>
                <button class="btn btn-outline-warning" ng-click="ctrl.onMinus(ctrl.infoId)">-</button>
                <button class="btn btn-outline-danger" ng-click="ctrl.onRemove(ctrl.infoId)">x</button>
            </div>
        </div>
    </div>
</div>
