<div id="responseToast" class="toast position-fixed border rounded custom-toast status-{{ctrl.statusCode}}">
    <div class="toast-header">
        <p><b>{{ctrl.message}}</b></p>
    </div>
    <div class="toast-body">
        <ul ng-if="ctrl.messages.length > 0" class="custom-list">
            <li class="text-left" ng-repeat="sms in ctrl.messages track by $index">{{sms}}</li>
        </ul>
    </div>
</div>
