<div class="d-md-flex" ng-if="ctrl.ShowView">
    <div class="container m-2 text-center text-md-end">
        <img class="border p-2 rounded" src="assets/images/logo.svg" alt="Logo" class="logo">
    </div>
    <div class="container m-2 d-sm-block d-md-flex align-items-center">
        <form name="loginForm" ng-submit="ctrl.register()">
            <div class="mb-3">
                <label for="email" class="form-label fw-bold">EMAIL</label>
                <input id="email" class="form-control" name="email" ng-model="ctrl.email" type="email">
            </div>
            <div class="mb-3">
                <label for="name" class="form-label fw-bold">NAME</label>
                <input id="name" class="form-control" name="name" ng-model="ctrl.name">
            </div>
            <div class="mb-3">
                <label for="surname" class="form-label fw-bold">SURNAME</label>
                <input id="surname" class="form-control" name="surname" ng-model="ctrl.surname">
            </div>
            <div class="mb-3 d-flex">
                <div class="me-1">
                    <label for="codearea" class="form-label fw-bold">CODEAREA</label>
                    <input id="codearea" class="form-control" name="codearea" ng-model="ctrl.codearea">
                </div>
                <div>
                    <label for="phone" class="form-label fw-bold">PHONE</label>
                    <input id="phone" class="form-control" name="phone" ng-model="ctrl.phone">
                </div>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label fw-bold">PASSWORD</label>
                <input id="password" class="form-control" name="password" ng-model="ctrl.password" type="password">
            </div>
            <div class="mb-3">
                <label for="re_password" class="form-label fw-bold">RE_PASSWORD</label>
                <input id="re_password" class="form-control" name="re_password" ng-model="ctrl.re_password" type="password">
            </div>
            <div class="mb-3">
                <a class="link-underline-info" href="/login">LOGIN</a>
            </div>
            <div class="text-center">
                <button class="btn btn-outline-primary fw-bold w-100">REGISTER</button>
            </div>
        </form>
    </div>
</div>