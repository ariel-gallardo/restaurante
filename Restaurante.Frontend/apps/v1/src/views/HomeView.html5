<div class="container-fluid py-4">
    <!-- Search Bar & Hero Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center text-white" style="background: radial-gradient(circle at top, #1e293b, #0f172a) !important; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                <h2 class="fw-bold text-gradient mb-2" style="font-size: 2rem;">¡Elige tu comida favorita!</h2>
                <p class="text-muted small mb-4" style="color: #94a3b8 !important;">Explora nuestro menú y realiza tu pedido en minutos.</p>
                <div class="mx-auto" style="max-width: 600px;">
                    <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border border-secondary">
                        <span class="input-group-text bg-theme-input border-0 text-muted ps-4 pe-2">🔍</span>
                        <input class="form-control bg-theme-input border-0 py-3 shadow-none text-theme-body" type="text" placeholder="¿Qué quieres comer hoy?" ng-model="ctrl.searchText">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content: Sidebar + Products -->
    <div class="row g-4">
        <!-- Sidebar Categories -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-body-tertiary">
                <h5 class="fw-bold mb-3 text-theme-body">Categorías</h5>
                <ul class="list-group list-group-flush rounded-3 overflow-hidden border">
                    <li class="list-group-item list-group-item-action hover-item py-3 d-flex align-items-center justify-content-between" 
                        id="cat-{{item.id}}" 
                        ng-click="ctrl.SeleccionarCategoria(item,$event)" 
                        ng-repeat="item in ctrl.CategoriesStore"
                        ng-class="{'active bg-primary text-white': item.selected}">
                        <span class="fw-semibold">{{item.nombre}}</span>
                        <span class="small opacity-50" ng-if="item.hasChildren">▶</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Product Grid -->
        <div class="col-md-9">
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                <div class="col" ng-repeat="item in ctrl.ProductsStore | filter: ctrl.searchText">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hover-scale bg-body-tertiary">
                        <!-- Product Image -->
                        <div class="position-relative" style="height: 180px; overflow: hidden; background-color: #f1f5f9;">
                            <img ng-src="{{item.imagenUrl || '/assets/images/anyProduct.svg'}}" class="w-100 h-100" style="object-fit: cover;" alt="{{item.nombre}}">
                            <span class="position-absolute top-3 end-3 badge bg-dark bg-opacity-75 text-white py-2 px-3 rounded-pill fw-bold" style="font-size: 1rem;">
                                ${{item.precioVenta}}
                            </span>
                        </div>
                        
                        <!-- Card Body -->
                        <div class="card-body p-4 d-flex flex-column">
                            <h5 class="card-title fw-bold text-theme-body mb-2">{{item.nombre}}</h5>
                            <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                {{item.descripcion || 'Sin descripción disponible.'}}
                            </p>
                            
                            <!-- Card Actions -->
                            <div class="mt-3 pt-3 border-top d-flex align-items-center justify-content-between">
                                <a href="#" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold">Detalles</a>
                                <div class="d-flex align-items-center gap-1">
                                    <button class="btn btn-sm btn-outline-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" ng-click="ctrl.InteractuarCarrito(item,'-')">
                                        <span class="fw-bold" style="line-height: 1;">-</span>
                                    </button>
                                    <span class="fw-bold px-2 text-theme-body" ng-if="item.seleccion > 0">{{item.seleccion}}</span>
                                    <button class="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" ng-click="ctrl.InteractuarCarrito(item,'+')">
                                        <span class="fw-bold" style="line-height: 1;">+</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Empty state when no products found -->
            <div class="d-flex flex-column align-items-center justify-content-center text-center py-5 w-100" style="min-height: 300px;" ng-if="(ctrl.ProductsStore | filter: ctrl.searchText).length === 0">
                <div class="p-4 rounded-4 bg-body-tertiary border text-center shadow-sm w-100" style="max-width: 450px; border: 2px dashed rgba(148, 163, 184, 0.35) !important;">
                    <span style="font-size: 3rem;">🍽️</span>
                    <h4 class="text-theme-body fw-bold mt-3 mb-2">No se encontraron productos</h4>
                    <p class="text-muted small mb-0">Intenta buscar otra palabra o selecciona una categoría diferente.</p>
                </div>
            </div>
        </div>
    </div>
</div>