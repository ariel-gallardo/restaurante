<div class="container py-5 d-flex align-items-center justify-content-center" ng-if="ctrl.ShowView" style="min-height: 70vh;">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden premium-card text-center" style="max-width: 450px; width: 100%;">
        <div class="card-header bg-dark p-4 border-0 d-flex flex-column align-items-center">
            <img class="border p-2 rounded bg-light mb-3 shadow-sm" src="assets/images/logo.svg" alt="Logo" style="width: 80px; height: auto;">
            <h3 class="mb-1 text-white fw-bold">{{ctrl.t.WELCOME}}</h3>
            <p class="text-muted small mb-0">{{ctrl.t.LOGIN}}</p>
        </div>
        
        <div class="card-body p-4 bg-body-tertiary">
            <form name="loginForm" ng-submit="ctrl.login()" novalidate>
                <div class="mb-4 text-start">
                    <label for="email" class="form-label small fw-bold text-theme-muted text-uppercase tracking-wider">{{ctrl.t.EMAIL}}</label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-theme-input border-end-0">📧</span>
                        <input id="email" class="form-control border-start-0 ps-0 bg-theme-input" name="email" ng-model="ctrl.email" type="email" placeholder="example@mail.com" required>
                    </div>
                </div>
                
                <div class="mb-4 text-start">
                    <label for="password" class="form-label small fw-bold text-theme-muted text-uppercase tracking-wider">{{ctrl.t.PASSWORD}}</label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-theme-input border-end-0">🔒</span>
                        <input id="password" class="form-control border-start-0 ps-0 bg-theme-input" name="password" ng-model="ctrl.password" type="password" placeholder="••••••••" required>
                    </div>
                </div>
                
                <div class="mb-4 d-flex justify-content-between align-items-center">
                    <a class="text-decoration-none small text-primary fw-semibold hover-underline" href="/register">
                        {{ctrl.t.CREATE_ACCOUNT}}
                    </a>
                </div>
                
                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-primary btn-lg fw-bold w-100 rounded-pill shadow-sm hover-scale bg-gradient">
                        {{ctrl.t.LOGIN}}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>