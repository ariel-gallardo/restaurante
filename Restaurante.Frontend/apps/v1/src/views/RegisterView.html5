<div class="container py-4 d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden premium-card" style="max-width: 700px; width: 100%;">
        <div class="card-header bg-dark p-4 border-0 d-flex flex-column align-items-center text-center">
            <img class="border p-2 rounded bg-light mb-3 shadow-sm" src="assets/images/logo.svg" alt="Logo" style="width: 75px; height: auto;">
            <h3 class="mb-1 text-white fw-bold">{{ctrl.t.REGISTER}}</h3>
            <p class="text-muted small mb-0">{{ctrl.t.REGISTER_SUBTITLE}}</p>
        </div>
        
        <div class="card-body p-4 bg-body-tertiary">
            <form name="loginForm" ng-submit="ctrl.RegisterUser" novalidate>
                <div class="row g-3">
                    <!-- Email -->
                    <div class="col-12">
                        <label for="email" class="form-label small fw-bold text-theme-muted text-uppercase tracking-wider">{{ctrl.t.EMAIL}}</label>
                        <input id="email" class="form-control bg-theme-input shadow-sm" name="email" ng-model="ctrl.email" type="email" placeholder="example@mail.com" required>
                    </div>
                    
                    <!-- Name & Surname -->
                    <div class="col-md-6">
                        <label for="name" class="form-label small fw-bold text-theme-muted text-uppercase tracking-wider">{{ctrl.t.NAME}}</label>
                        <input id="name" class="form-control bg-theme-input shadow-sm" name="name" ng-model="ctrl.name" placeholder="John" required>
                    </div>
                    <div class="col-md-6">
                        <label for="surname" class="form-label small fw-bold text-theme-muted text-uppercase tracking-wider">{{ctrl.t.SURNAME}}</label>
                        <input id="surname" class="form-control bg-theme-input shadow-sm" name="surname" ng-model="ctrl.surname" placeholder="Doe" required>
                    </div>
                    
                    <!-- CodeArea & Phone -->
                    <div class="col-md-4">
                        <label for="codearea" class="form-label small fw-bold text-theme-muted text-uppercase tracking-wider">{{ctrl.t.CODEAREA}}</label>
                        <input ng-change="ctrl.vRange.CodeArea()" id="codearea" class="form-control bg-theme-input shadow-sm" name="codearea" ng-model="ctrl.codearea" placeholder="11" required>
                    </div>
                    <div class="col-md-8">
                        <label for="phone" class="form-label small fw-bold text-theme-muted text-uppercase tracking-wider">{{ctrl.t.PHONE}}</label>
                        <input ng-change="ctrl.vRange.Phone()" id="phone" class="form-control bg-theme-input shadow-sm" name="phone" ng-model="ctrl.phone" placeholder="12345678" required>
                    </div>
                    
                    <!-- Street & Number -->
                    <div class="col-md-8">
                        <label for="street" class="form-label small fw-bold text-theme-muted text-uppercase tracking-wider">{{ctrl.t.STREET}}</label>
                        <input id="street" class="form-control bg-theme-input shadow-sm" name="street" ng-model="ctrl.street" placeholder="Av. Corrientes" required>
                    </div>
                    <div class="col-md-4">
                        <label for="numstreet" class="form-label small fw-bold text-theme-muted text-uppercase tracking-wider">{{ctrl.t.NUMBER}}</label>
                        <input ng-change="ctrl.vRange.StreetNum()" id="numstreet" class="form-control bg-theme-input shadow-sm" name="numstreet" ng-model="ctrl.numstreet" placeholder="1234" required>
                    </div>
                    
                    <!-- Department & Locality selectors -->
                    <div class="col-md-6">
                        <label for="floatingSelect" class="form-label small fw-bold text-theme-muted text-uppercase tracking-wider">{{ctrl.t.DEPARTAMENT}}</label>
                        <select ng-model="ctrl.DepartamentoActual" id="floatingSelect" class="form-select bg-theme-input shadow-sm">
                            <option value="" selected disabled>{{ctrl.t.SELECT}}</option>
                            <option ng-repeat="d in ctrl.departamentos" value="{{d.nombre}}">{{d.nombre}}</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="floatingSelect2" class="form-label small fw-bold text-theme-muted text-uppercase tracking-wider">{{ctrl.t.LOCALITY}}</label>
                        <select ng-model="ctrl.LocalidadActual" id="floatingSelect2" class="form-select bg-theme-input shadow-sm">
                            <option value="" selected disabled>{{ctrl.t.SELECT}}</option>
                            <option ng-repeat="d in ctrl.localidades" value="{{d.nombre}}">{{d.nombre}}</option>
                        </select>
                    </div>
                    
                    <!-- Passwords -->
                    <div class="col-md-6">
                        <label for="password" class="form-label small fw-bold text-theme-muted text-uppercase tracking-wider">{{ctrl.t.PASSWORD}}</label>
                        <input id="password" class="form-control bg-theme-input shadow-sm" name="password" ng-model="ctrl.password" type="password" placeholder="••••••••" required>
                    </div>
                    <div class="col-md-6">
                        <label for="re_password" class="form-label small fw-bold text-theme-muted text-uppercase tracking-wider">{{ctrl.t.RE_PASSWORD}}</label>
                        <input id="re_password" class="form-control bg-theme-input shadow-sm" name="re_password" ng-model="ctrl.re_password" type="password" placeholder="••••••••" required>
                    </div>
                </div>
                
                <div class="mt-4 d-flex align-items-center justify-content-center w-100">
                    <span class="small text-muted me-2">{{ctrl.t.ALREADY_HAVE_ACCOUNT}}</span>
                    <a class="text-decoration-none small text-primary fw-semibold hover-underline" href="/login">
                        {{ctrl.t.LOGIN}}
                    </a>
                </div>
                
                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-primary btn-lg fw-bold w-100 rounded-pill shadow-sm hover-scale bg-gradient">
                        {{ctrl.t.REGISTER}}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>