{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": [
      "@resto/source"
    ],
    "paths": {
      "@resto/v1": [
        "libs/v1/src/index.ts"
      ],
      "@resto/v2": [
        "libs/v2/src/index.ts"
      ],
      "@resto/shell": [
        "libs/v2/shell/src/index.ts"
      ],
      "@resto/legacy-host": [
        "libs/v1/src/lib/legacy-host/src/index.ts"
      ]
    }
  }
}
